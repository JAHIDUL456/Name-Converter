{
  "name": "easybn",
  "version": "1.0.3",
  "description": "Bangla to English personal name converter and Bengali name transliteration for JavaScript, TypeScript, and Node.js. Offline, zero-dependency Bangladesh NID, KYC, banking, and bulk name conversion.",
  "keywords": [
    "bangla-name-converter",
    "bengali-name-transliteration",
    "bangla-to-english-name",
    "bangla-to-english",
    "bengali-transliteration",
    "bangladesh-nid",
    "nid-name-converter",
    "kyc",
    "fintech",
    "banking",
    "insurance",
    "bulk-name-conversion",
    "offline-transliteration",
    "bengali-romanization",
    "unicode",
    "typescript",
    "nodejs",
    "zero-dependencies"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JAHIDUL456/Name-Converter.git"
  },
  "homepage": "https://github.com/JAHIDUL456/Name-Converter#readme",
  "bugs": {
    "url": "https://github.com/JAHIDUL456/Name-Converter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dict:compile": "node scripts/compile-dictionary.mjs",
    "dict:validate": "node scripts/compile-dictionary.mjs --check",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:only": "node --test tests/*.test.mjs",
    "eval:accuracy": "npm run build && node benchmarks/accuracy-eval.mjs",
    "bench": "npm run build && node benchmarks/run.mjs",
    "pack:verify": "npm run build && node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2"
  },
  "author": {
    "name": "Md. Jahidul Islam",
    "url": "https://github.com/JAHIDUL456"
  }
}
